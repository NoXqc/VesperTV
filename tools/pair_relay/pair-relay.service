[Unit]
Description=VesperTV pairing relay (Add Playlist > From my phone)
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/pair-relay/relay.py
Environment=PAIR_HOST=127.0.0.1 PAIR_PORT=8930 PAIR_PAGE=/opt/pair-relay/pair.html PAIR_VAULT_DIR=/var/lib/pair-relay
# Reject app calls without X-VesperTV-App (on since 2026-10-17; 1.0.14/1.0.15
# installs, which don't send it, must update for Transfer/From phone).
Environment=PAIR_REQUIRE_APP=1
# PAIR_LOG_WEBHOOK=<Discord webhook URL> for Send log (secret, root-only
# file, never in the repo). Without it /api/log answers 503.
EnvironmentFile=-/etc/pair-relay.env
Restart=always
RestartSec=2
# Runs as a throwaway user. Pairing is memory only; the only writable place
# is the vault's state dir (encrypted internet-transfer blobs, auto-expired).
DynamicUser=yes
StateDirectory=pair-relay
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
MemoryMax=128M

[Install]
WantedBy=multi-user.target
