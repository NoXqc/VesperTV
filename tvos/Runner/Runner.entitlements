<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Apple TV app's entitlements. Same file on claude/welcome-sync and
     claude/appletv-parity, so the two branches merge cleanly.
     iCloud: CloudKit backups in iCloud.app.vespertv.player
     (lib/services/icloud_backups.dart, dev-notes/icloud-backups.md).
     App Group: the Top Shelf rows (VesperTopShelf in AppDelegate.swift, the
     TopShelf extension, dev-notes/apple-tv-parity-plan.md).
     Both need their capability on app.vespertv.player in the Apple developer
     portal before a signed Apple TV build. They only reach a build through
     tvos-build.yml's ad-hoc archive signature (Phase 0 in the plan). -->
<plist version="1.0">
<dict>
	<!-- tvOS: App Store Connect refuses CloudKit (icloud-services) without this
	     (ITMS 90575, TestFlight 967, 2026-11-23); nothing sends notifications.
	     Push Notifications is on for app.vespertv.player in the portal. -->
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.app.vespertv.player</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.vespertv.player</string>
	</array>
</dict>
</plist>
